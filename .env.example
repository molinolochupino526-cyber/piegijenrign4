# ---------------------------------------------------------------------------
# Скопируйте этот файл в .env и подставьте свои значения:  cp .env.example .env
# ---------------------------------------------------------------------------

# --- Выбор провайдера озвучки: fish | azure ---------------------------------
# fish  — основной провайдер, при ошибке автоматически переключается на azure
# azure — использовать только Azure TTS
TTS_PROVIDER=fish

# --- Fish Audio -------------------------------------------------------------
FISH_API_KEY=your_fish_audio_api_key
# ID голоса (reference_id) из библиотеки Fish Audio
FISH_VOICE_ID=
FISH_MODEL=speech-1.6
FISH_API_URL=https://api.fish.audio/v1/tts

# --- Azure Speech (fallback) ------------------------------------------------
AZURE_SPEECH_KEY=your_azure_key
AZURE_SPEECH_REGION=westeurope
AZURE_VOICE=ru-RU-SvetlanaNeural
# Стиль произношения Azure (newscast, cheerful, calm...); пусто — без стиля
AZURE_STYLE=
# Скорость речи: -20% ... +50%
SPEECH_RATE=+8%

# --- Сеть -------------------------------------------------------------------
TTS_TIMEOUT=180
TTS_MAX_RETRIES=4
TTS_BACKOFF_BASE=2.0

# --- Пути -------------------------------------------------------------------
TICKETS_DIR=tickets
OUTPUT_DIR=output
BACKGROUND_VIDEO=assets/background.mp4

# --- Разбиение текста -------------------------------------------------------
PART_TARGET_CHARS=3000

# --- Видео ------------------------------------------------------------------
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
FONT_SIZE_CURRENT=60
FONT_SIZE_SIDE=30
SIDE_OPACITY=0.5
HIGHLIGHT_COLOR=#FFD400
TEXT_COLOR=#FFFFFF

# --- Параллелизм ------------------------------------------------------------
TTS_WORKERS=4
RENDER_WORKERS=2
